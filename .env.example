# YClick Expo Client Configuration
# Copy this file to .env or .env.local

# Backend API URL (Use 10.0.2.2 for Android Emulator, or your machine's local Wi-Fi IP for physical devices)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Firebase Web Client Configuration (Optional for production Firebase auth/storage)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Supabase Configuration (Free Tier Storage & Auth)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Groq Fast AI (Llama / OSS 120B) for Spatial Intelligence & Chat
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cloudflare Workers AI for Free Image Generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

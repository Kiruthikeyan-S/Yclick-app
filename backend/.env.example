# YClick Backend Environment Configuration
# Copy this file to .env and provide your valid credentials.

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=*

# AI Image Generation Provider (Options: mock, openai, stability, replicate)
AI_IMAGE_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
STABILITY_API_KEY=your_stability_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Firebase Admin SDK Configuration (Optional: for verifying client ID tokens)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-service-account.json

# Product Catalog API (Optional)
PRODUCT_PROVIDER=demo_catalog
PRODUCT_API_KEY=your_product_api_key_here

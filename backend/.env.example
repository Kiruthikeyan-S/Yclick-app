# ==============================================================================
# YClick FastAPI AI Backend Environment Configuration (.env.example)
# Copy this file to backend/.env and populate with valid credentials.
# NEVER commit the filled .env file to public version control.
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# CORS Configuration
# Comma-separated allowed origins (e.g., http://localhost:8081,exp://192.168.1.10:8081).
# If set to '*', allow_credentials will automatically be set to False to comply with CORS spec.
CORS_ORIGINS=*

# Cloudflare Workers AI Configuration (Vision & Inpainting Image-to-Image)
# Required for @cf/llava-hf/llava-1.5-7b-hf and @cf/runwayml/stable-diffusion-v1-5-inpainting
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=cfut_your_cloudflare_workers_ai_api_token_here

# Groq LPU API Configuration (Structured Spatial Architecture Diagnosis & Designer Chat)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Firebase Admin SDK Configuration (Server-Side ID Token Verification & Claim Sync)
# Provide the Firebase project ID and either a path to service account JSON or raw JSON string
FIREBASE_PROJECT_ID=yclick-59688
FIREBASE_SERVICE_ACCOUNT_PATH=backend/firebase_service_account.json
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Supabase Server-Side Configuration (Optional: for server-side user data cleanup)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Demonstration / Fallback Modes (Default to false in production)
# Set to 'true' only in isolated demo environments without live AI provider credentials
ALLOW_DEMO_MODE=false
ALLOW_DEMO_PRODUCTS=false
